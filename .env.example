# API keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Task Decomposer
TASK_DECOMPOSER_PROVIDER=openai
TASK_DECOMPOSER_MODEL=your_openai_model_here
TASK_DECOMPOSER_USE_VISION=false

# Skill Generator
SKILL_GENERATOR_PROVIDER=openai
SKILL_GENERATOR_MODEL=your_openai_model_here
SKILL_GENERATOR_USE_VISION=false

# Code-as-Policies benchmark (optional; defaults to Skill Generator settings)
CAP_PROVIDER=
CAP_MODEL=
CAP_WEB_HOST=127.0.0.1
CAP_WEB_PORT=8010

# Parameter Setter
PARAMETER_SETTER_PROVIDER=openai
PARAMETER_SETTER_MODEL=your_openai_model_here
PARAMETER_SETTER_USE_VISION=false

# Vision Module
VISION_MODULE_PROVIDER=gemini
VISION_MODULE_MODEL=gemini-3.1-pro-preview

# Robot server, state reader, and reset helper
# Select scene/robot/<ROBOT_TYPE>/ros1.py or ros2.py via GTA_BACKEND.
# Also selects state.py and helpers.py in that robot directory. Only ur5e is bundled.
ROBOT_TYPE=ur5e
# Gripper selection is independent of the robot; only robotiq is bundled.
# Select scene/gripper/<GRIPPER_TYPE>/ros1.py or ros2.py via GTA_BACKEND.
GRIPPER_TYPE=robotiq
# GTA command/server and gripper middleware: ros1 or ros2, independent of camera.
GTA_BACKEND=ros1
# Shared UR5e address for robot state, ROS servers, and GUI reset helper.
ROBOT_IP=192.168.1.10

# Tool geometry (JSON), independent of ROBOT_TYPE; defaults match the existing setup.
# Local point offset in metres and named directions relative to RobotState's pose.
# This does not set the physical robot's TCP. Axis signs/magnitudes are preserved.
# Restart the app and regenerate the script after changing these values.
TOOL_TCP_OFFSET=[0, 0, 0.1628]
TOOL_AXES={"x":[0,-1,0],"y":[-1,0,0],"z":[0,0,1]}

# Camera
# Use "file" to read an image from CAMERA_IMAGE_PATH for offline testing.
# Use "ros1" for ROS 1 camera topics or "ros2" for ROS 2 camera topics.
CAMERA_BACKEND=file
CAMERA_IMAGE_PATH=environment.jpg
CAMERA_NODE=/zed_node
CAMERA_MODEL=zed2i
# Optional full ROS 2 topic overrides. Leave blank to derive the same suffixes
# as the ROS 1 backend from CAMERA_NODE and CAMERA_MODEL.
CAMERA_COLOR_TOPIC=
CAMERA_POINT_CLOUD_TOPIC=
ROSMASTER_IP=localhost
ROSMASTER_PORT=11311
# ROS 2 uses the sourced ROS environment and optional ROS_DOMAIN_ID instead of
# ROSMASTER_IP/ROSMASTER_PORT.
# These robot settings apply when GTA_BACKEND=ros2.
ROS2_GRIPPER_ACTION_NAME=/robotiq_gripper_controller/gripper_cmd
ROS2_GRIPPER_WAIT_TIMEOUT_S=10.0
ROS2_PUBLISHER_MATCH_TIMEOUT_S=5.0
T_BASE_CAM=[[0.70857228,-0.49764763,0.50027208,-0.48682316],[-0.70322773,-0.43945916,0.5588796,-0.97660094],[-0.05827596,-0.74781179,-0.66134819,0.5947388],[0.0,0.0,0.0,1.0]]

# Web dashboard
GTA_WEB_HOST=127.0.0.1
GTA_WEB_PORT=8000
GTA_WEB_RELOAD=false

# Separate Prepare / Library / Run application (python library.py)
GTA_LIBRARY_HOST=127.0.0.1
GTA_LIBRARY_PORT=8001
